; Drop-in QA/debug template for 《猫忍不住》 v1.2.22
; Merge the InputMap/autoload entries into the production project.godot rather than replacing it.
config_version=5

[application]
config/name="猫忍不住 - v1.2.22 Debug QA Template"
run/main_scene="res://scenes/debug/debug_console_demo.tscn"

[display]
window/size/viewport_width=1152
window/size/viewport_height=648

[autoload]
DebugConsole="*res://scripts/debug/debug_console.gd"
QATestRunner="*res://scripts/qa/qa_test_runner.gd"

[input]
debug_toggle={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":96)]}
debug_command={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":59)]}
